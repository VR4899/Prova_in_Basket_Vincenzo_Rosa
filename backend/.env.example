MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=fisco_facile

PUBLIC_SITE_URL=https://www.example.com
SUPPORT_EMAIL=supporto@example.com
COMPANY_LEGAL_NAME=Fisco Facile SRL
VAT_ID=IT00000000000

GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
# In alternativa puoi passare direttamente il JSON del service account:
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_LEADS_TAB=Leads
GOOGLE_SHEETS_ORDERS_TAB=Orders
GOOGLE_SHEETS_TRACKING_TAB=Tracking

ADMIN_EMAIL=admin@fiscofacile.it
# Preferito: salva solo l'hash della password admin
ADMIN_PASSWORD_HASH=
# Fallback locale semplice se non usi l'hash
ADMIN_PASSWORD=change-me
ADMIN_SESSION_HOURS=4
ADMIN_MAX_FAILED_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15
ADMIN_PREVIEW_TOKEN_MINUTES=10
CUSTOMER_MAGIC_LINK_HOURS=24
CUSTOMER_SESSION_HOURS=12
CUSTOMER_ACCESS_MAX_REQUESTS_PER_HOUR=5
CUSTOMER_TEST_ACCESS_LOCAL_ONLY=true
TEST_BYPASS_LOCAL_ONLY=true

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://www.example.com
CORS_ALLOW_ORIGIN_REGEX=https://.*\.vercel\.app

# true = salta Stripe e usa il bypass locale
STRIPE_MOCK=false
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# true = mostra i pulsanti di bypass in locale
ALLOW_TEST_BYPASS=false

# Se lasci RESEND_API_KEY vuoto, l'app salva le email come anteprima nell'admin.
RESEND_API_KEY=
SENDER_EMAIL=noreply@example.com
EMAIL_DELIVERY_MODE=auto
